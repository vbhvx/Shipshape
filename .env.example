# Shipshape — Full-Stack Application Builder
# Template only. Never put real credentials in this file.

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Shipshape
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon PostgreSQL
# Required in production. Use the appropriate pooled connection string
# for application queries.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/neondb?sslmode=require

# Direct connection for Prisma migrations and database import scripts.
DIRECT_URL=postgresql://USER:PASSWORD@YOUR-NEON-DIRECT-HOST/neondb?sslmode=require

# Clerk Authentication
# Use development keys locally and production keys in deployment.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY

# Sandbox Runtime
SANDBOX_EXECUTION_TIMEOUT_MS=30000
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_PORT_START=3100

# External AI
# Optional: the current deterministic engine does not require an LLM API key.
# GEMINI_API_KEY=
